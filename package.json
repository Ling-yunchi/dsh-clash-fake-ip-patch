{
  "name": "dsh-clash-fake-ip",
  "version": "0.1.0",
  "description": "Installable Clash fake-IP DNS compatibility for DeepSeek Harness web_fetch",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["src/", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ling-yunchi/dsh-clash-fake-ip-patch.git"
  },
  "bugs": { "url": "https://github.com/Ling-yunchi/dsh-clash-fake-ip-patch/issues" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:live": "node --test tests/live.e2e.js",
    "test:install": "node --test tests/install.e2e.js",
    "typecheck": "tsc --noEmit --allowJs --checkJs --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck src/index.js src/resolver.js"
  },
  "dependencies": { "ipaddr.js": "^2.5.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
